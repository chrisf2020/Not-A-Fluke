#!/usr/bin/env python3
# fluke-calibrate — calibrates the small touchscreen.  Run it with:  fluke calibrate
#
# How it works:
#   1. Shows a cross in each corner of the small screen, one at a time. You tap each one.
#   2. The touch chip reports "raw" numbers (0-4095) for where you tapped. We compare
#      those with where the cross actually was to work out the conversion from
#      raw numbers to screen pixels (and whether the X/Y directions are swapped).
#   3. Saves the result to /etc/pi-fluke-touch.json (for Pi Fluke) and to the desktop's
#      touch settings (/etc/X11/xorg.conf.d/99-calibration.conf).
#   4. Test mode: tap anywhere and a dot appears where the screen thinks you touched.
#
# HOW TO READ THIS FILE: every line of code has a "#" comment above it explaining it.

# Load tools: glob (find files), json (save settings), statistics (median), subprocess (run commands),
# sys (exit), time (pauses).
import glob, json, statistics, subprocess, sys, time
# numpy = fast math on every pixel at once.
import numpy as np
# Print messages immediately instead of saving them up.
sys.stdout.reconfigure(line_buffering=True)   # show messages right away
# evdev = read the touchscreen's raw events (touch down, finger position, touch up).
import evdev
# ecodes = names for the event types (e.g. ABS_X = "X position").
from evdev import ecodes
# Pillow = draw pictures and text.
from PIL import Image, ImageDraw, ImageFont

# Where Pi Fluke's calibration gets saved.
SAVE_FILE = "/etc/pi-fluke-touch.json"
# Where the desktop's touch calibration gets saved.
X_CONF = "/etc/X11/xorg.conf.d/99-calibration.conf"
# The crosses are 30 pixels in from the edges (easier to hit than the very corner).
MARGIN = 30                      # how far the crosses are from the screen edges (pixels)
# Font for the instructions.
FONT = ImageFont.truetype("/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf", 16)


# ---------- screen helpers (same idea as fluke-screen) ----------
# Find the small screen and its size (same as in fluke-screen).
def find_tft():
    # Look through every screen's name...
    for path in sorted(glob.glob("/sys/class/graphics/fb*/name")):
        # ...the small one's name starts with "fb_".
        if open(path).read().startswith("fb_"):
            # e.g. "fb2"
            fb = path.split("/")[-2]
            # e.g. 480 and 320
            w, h = open(f"/sys/class/graphics/{fb}/virtual_size").read().strip().split(",")
            # Give back the device path, width, height.
            return f"/dev/{fb}", int(w), int(h)
    # No screen found -> stop.
    sys.exit("small TFT screen not found")

# FB = /dev/fb2, W = 480, H = 320
FB, W, H = find_tft()

# A function that puts a picture on the small screen.
def show(img):
    """Write a Pillow picture onto the small screen (RGB565)."""
    # Picture -> grid of numbers.
    px = np.asarray(img, dtype=np.uint16)
    # Squeeze each pixel into the screen's 16-bit colour format.
    rgb565 = ((px[..., 0] >> 3) << 11) | ((px[..., 1] >> 2) << 5) | (px[..., 2] >> 3)
    # Open the screen...
    with open(FB, "wb") as f:
        # ...and write the pixels.
        f.write(rgb565.astype("<u2").tobytes())

# A function that makes a black picture with centred text on it.
def screen_with_text(text):
    # Blank black picture.
    img = Image.new("RGB", (W, H), "black")
    # A "pen" to draw with.
    d = ImageDraw.Draw(img)
    # Write the text in the middle of the screen ("mm" = middle-middle).
    d.multiline_text((W // 2, H // 2), text, font=FONT, fill="white", anchor="mm", align="center")
    # Give back the picture and the pen (so crosses/dots can be added).
    return img, d


# ---------- touch helpers ----------
# Find the touchscreen among all input devices (keyboard, mouse, power button, touch...).
def find_touch():
    # Go through each input device...
    for path in evdev.list_devices():
        # ...open it...
        dev = evdev.InputDevice(path)
        # ...and if its name says ADS7846 (our touch chip) or "touch", that's the one.
        if "ADS7846" in dev.name or "touch" in dev.name.lower():
            return dev
    # None found -> stop.
    sys.exit("touchscreen not found")

# The touchscreen device.
touch = find_touch()

# A function that waits for one tap and returns where it was (in raw touch numbers).
def wait_for_tap():
    """Wait for one tap. Returns the raw (x, y) the chip reported (median = ignores jitter)."""
    # xs/ys = all the positions seen during this tap; down = finger on the screen?; x/y = latest position.
    xs, ys, down, x, y = [], [], False, None, None
    # Read touchscreen events one at a time, forever, until we return.
    for ev in touch.read_loop():
        # An X position update -> remember it.
        if ev.type == ecodes.EV_ABS and ev.code == ecodes.ABS_X: x = ev.value
        # A Y position update -> remember it.
        if ev.type == ecodes.EV_ABS and ev.code == ecodes.ABS_Y: y = ev.value
        # A touch "button" event = finger went down (1) or lifted (0).
        if ev.type == ecodes.EV_KEY and ev.code == ecodes.BTN_TOUCH:
            # down = True if the finger is on the screen.
            down = ev.value == 1
            # Finger lifted, and we saw at least one position...
            if not down and xs:                    # finger lifted -> done
                # ...print the tap (the "median" is the middle value, which ignores jumpy readings)...
                print(f"  tap: raw {statistics.median(xs):.0f},{statistics.median(ys):.0f} ({len(xs)} readings)")
                # ...and give back that position.
                return statistics.median(xs), statistics.median(ys)
        # End of a batch of readings while the finger is down -> save the current position.
        if ev.type == ecodes.EV_SYN and down and x is not None and y is not None:
            xs.append(x); ys.append(y)


# ---------- step 1: tap the 4 corners ----------
# Where the 4 crosses go: top-left, top-right, bottom-left, bottom-right (30px in from the edges).
targets = [(MARGIN, MARGIN), (W - MARGIN, MARGIN), (MARGIN, H - MARGIN), (W - MARGIN, H - MARGIN)]
# The raw tap positions will be collected here.
raw = []
# "grab" = only this program gets the taps, so the desktop mouse doesn't move while calibrating.
touch.grab()                     # stop the desktop from also reacting to these taps
# "try ... finally" = whatever happens (even an error), run the "finally" part at the end (release the grab).
try:
    # For each cross (n = 1, 2, 3, 4; tx/ty = where the cross is)...
    for n, (tx, ty) in enumerate(targets, 1):
        # ...make a screen with instructions...
        img, d = screen_with_text(f"Touch calibration\n\nTap the center of the cross\n({n} of 4)")
        # ...draw the horizontal line of the red cross...
        d.line((tx - 15, ty, tx + 15, ty), fill="red", width=3)
        # ...draw the vertical line of the red cross...
        d.line((tx, ty - 15, tx, ty + 15), fill="red", width=3)
        # ...show it...
        show(img)
        # ...tell the terminal too...
        print(f"Tap cross {n} of 4...")
        # ...wait for the tap and save where it was...
        raw.append(wait_for_tap())
        # ...and pause a moment so one tap doesn't count twice.
        time.sleep(0.3)

    # ---------- step 2: work out the conversion ----------
    # Unpack the 4 taps: 1 = top-left, 2 = top-right, 3 = bottom-left, 4 = bottom-right.
    (x1, y1), (x2, y2), (x3, y3), (x4, y4) = raw
    # Going left->right across the screen, which raw number changed more? That one is "screen X".
    # (Compare how much raw Y changed vs raw X between left and right taps.)
    swap = abs(y2 - y1) + abs(y4 - y3) > abs(x2 - x1) + abs(x4 - x3)
    # If they're swapped...
    if swap:   # the chip's Y is the screen's X (the screen is rotated)
        # ...swap X and Y in every tap so the rest of the math is simple.
        (x1, y1), (x2, y2), (x3, y3), (x4, y4) = (y1, x1), (y2, x2), (y3, x3), (y4, x4)

    # Average raw X of the two left taps, and of the two right taps.
    left, right = (x1 + x3) / 2, (x2 + x4) / 2     # raw value at the left / right crosses
    # Average raw Y of the two top taps, and of the two bottom taps.
    top, bottom = (y1 + y2) / 2, (y3 + y4) / 2     # raw value at the top / bottom crosses
    # How many raw units = 1 pixel across (distance between crosses is W - 60 pixels).
    per_px_x = (right - left) / (W - 2 * MARGIN)   # raw units per pixel
    # Same for up/down.
    per_px_y = (bottom - top) / (H - 2 * MARGIN)
    # Work out the raw numbers at the very edges of the screen (30px beyond the crosses) and save them.
    cal = {  # raw values at the very edges of the screen (can be "backwards", that's fine)
        # Were X and Y swapped?
        "swap": swap,
        # Raw X at the left edge and right edge.
        "x_min": round(left - MARGIN * per_px_x), "x_max": round(right + MARGIN * per_px_x),
        # Raw Y at the top edge and bottom edge.
        "y_min": round(top - MARGIN * per_px_y), "y_max": round(bottom + MARGIN * per_px_y),
        # Screen size.
        "width": W, "height": H,
    }
    # Show the result in the terminal.
    print("Calibration:", cal)

    # A function that turns a raw tap into a screen pixel using the calibration.
    def to_screen(rx, ry):
        # Swap if needed.
        if cal["swap"]: rx, ry = ry, rx
        # How far across (0 to 1) the tap is, times the width = pixel X.
        sx = (rx - cal["x_min"]) / (cal["x_max"] - cal["x_min"]) * W
        # How far down (0 to 1) the tap is, times the height = pixel Y.
        sy = (ry - cal["y_min"]) / (cal["y_max"] - cal["y_min"]) * H
        # Whole pixels.
        return int(sx), int(sy)

    # ---------- step 3: save ----------
    # Save the calibration as JSON to SAVE_FILE (sudo tee = write a file that needs admin rights).
    subprocess.run(["sudo", "tee", SAVE_FILE], input=json.dumps(cal, indent=2).encode(),
                   stdout=subprocess.DEVNULL, check=True)
    # The desktop's touch settings file, with our new numbers filled in.
    x_conf = f'''Section "InputClass"
        Identifier      "calibration"
        MatchProduct    "ADS7846 Touchscreen"
        Option  "Calibration"   "{cal['x_min']} {cal['x_max']} {cal['y_min']} {cal['y_max']}"
        Option  "SwapAxes"      "{1 if swap else 0}"
EndSection
'''
    # Back up the old desktop settings file as .bak first.
    subprocess.run(["sudo", "cp", X_CONF, X_CONF + ".bak"], stderr=subprocess.DEVNULL)
    # Write the new desktop settings file.
    subprocess.run(["sudo", "tee", X_CONF], input=x_conf.encode(), stdout=subprocess.DEVNULL, check=True)
    # Tell the user where it was saved.
    print(f"Saved to {SAVE_FILE} and {X_CONF} (old one kept as .bak)")

    # ---------- step 4: test it ----------
    # Show test instructions.
    img, d = screen_with_text("Saved!  Test it:\ntap anywhere, a dot shows where\nthe screen thinks you touched.\n\nTap 8 times to finish.")
    show(img)
    print("Test: tap anywhere on the small screen (8 taps)...")
    # 8 times...
    for i in range(8):
        # ...wait for a tap and convert it to a screen pixel...
        sx, sy = to_screen(*wait_for_tap())
        # ...draw a green dot there...
        d.ellipse((sx - 6, sy - 6, sx + 6, sy + 6), fill="lime")
        # ...and show it. If the dot is under your finger, calibration is good.
        show(img)
    # Finished screen.
    img, d = screen_with_text("Calibration done!")
    show(img)
    print("Done. (The desktop picks up the new setting next time it starts.)")
# Always runs at the end, even after an error or Ctrl+C:
finally:
    # Give the touchscreen back to the desktop.
    touch.ungrab()
