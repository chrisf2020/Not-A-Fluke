#!/bin/bash
# notafluke: starts Not-A-Fluke. On the Pi it runs the GUI on the small screen with its own X
# server (works over SSH). With no small screen it opens a 480x320 window on the desktop.
#
#   notafluke            start the GUI (-f = in the foreground, Ctrl-C stops it)
#   notafluke stop       close the GUI, give the screen back to the terminal
#   notafluke log        show the GUI's output
#   notafluke test       run the tests
#   notafluke calibrate  calibrate the touchscreen
#   notafluke update     git pull and restart the GUI if running
#   notafluke install    install packages, the notafluke command and start-on-boot
#   notafluke autostart on|off   start the GUI on boot or not (no on/off = show which)

DIR="$(dirname "$(readlink -f "$0")")"
SELF="$DIR/notafluke"
LOG=/tmp/notafluke.log
DISPLAY_NUM=:1
GUI_MATCH="^python3 -m fluke( |$)"   # the running GUI (^ so it only matches the GUI itself)

# commands that don't need root
case "$1" in
  test)    cd "$DIR" && exec python3 -m unittest discover -s tests -v ;;
  log)     cat "$LOG"; exit 0 ;;
  update)
    # run as the user so git files aren't owned by root
    [ "$(id -u)" = 0 ] && [ -n "$SUDO_USER" ] && exec sudo -u "$SUDO_USER" "$SELF" update
    git -C "$DIR" pull --ff-only || exit 1
    if pgrep -f "$GUI_MATCH" >/dev/null; then "$SELF" stop; "$SELF"; fi
    exit 0 ;;
  try)
    # each branch gets its own worktree in ~/fluke-try/<branch>, this folder isn't touched
    [ "$(id -u)" = 0 ] && [ -n "$SUDO_USER" ] && exec sudo -u "$SUDO_USER" "$SELF" "$@"
    TRY_DIR="$HOME/fluke-try"
    git -C "$DIR" fetch -q --prune origin || { echo "Couldn't reach GitHub." >&2; exit 1; }
    if [ -z "$2" ]; then
      echo "Branches on GitHub:"; git -C "$DIR" branch -r --format='  %(refname:lstrip=3)' | grep -v '^  HEAD$'
      echo "Try one:  notafluke try <branch>      Delete the copies:  notafluke try clean"; exit 0
    fi
    if [ "$2" = "clean" ]; then
      for copy in "$TRY_DIR"/*/; do [ -d "$copy" ] && git -C "$DIR" worktree remove --force "$copy"; done
      git -C "$DIR" worktree prune; echo "Removed the test copies in $TRY_DIR"; exit 0
    fi
    BRANCH="$2"; COPY="$TRY_DIR/${BRANCH//\//-}"
    git -C "$DIR" rev-parse -q --verify "origin/$BRANCH" >/dev/null || { echo "No branch '$BRANCH' on GitHub." >&2; exit 1; }
    if [ -d "$COPY" ]; then
      git -C "$COPY" checkout -q --detach "origin/$BRANCH" || { echo "Couldn't update $COPY (edited files in it?)" >&2; exit 1; }
    else
      mkdir -p "$TRY_DIR"; git -C "$DIR" worktree add -q --detach "$COPY" "origin/$BRANCH" || exit 1
    fi
    echo "Running $BRANCH ($(git -C "$COPY" log -1 --format='%h %s')) from $COPY"
    exec "$COPY/notafluke" "${@:3}" ;;
esac

# anything else isn't a command, show the list instead of starting the GUI
case "$1" in
  ""|-f|boot|stop|calibrate|install|autostart|blank|view|window) ;;
  *) echo "notafluke: unknown command '$1'"; sed -n '/^#   /s/^# //p' "$SELF"; exit 1 ;;
esac

# needs root (packet sniffing, X). Re-run with sudo and keep DISPLAY, which sudo drops
if [ "$(id -u)" != 0 ]; then
  if [ -n "$DISPLAY" ]; then
    xhost +SI:localuser:root >/dev/null 2>&1   # let root draw on this desktop
    exec sudo env DISPLAY="$DISPLAY" XAUTHORITY="${XAUTHORITY:-$HOME/.Xauthority}" "$SELF" "$@"
  fi
  exec sudo "$SELF" "$@"
fi

# at boot the screen driver can show up a few seconds late, so wait for it
if [ "$1" = "boot" ]; then
  for i in $(seq 30); do grep -qs '^fb_' /sys/class/graphics/fb*/name && break; sleep 1; done
fi

# find the small screen (framebuffer name starts with fb_)
FB=$(grep -l '^fb_' /sys/class/graphics/fb*/name 2>/dev/null | head -1 | cut -d/ -f5)

# packages come from apt, newer Pi OS / Debian block sudo pip install
PACKAGES="python3 python3-tk python3-scapy speedtest-cli lldpd iw tcpdump network-manager iputils-ping iproute2 x11-xserver-utils python3-pil python3-qrcode"
# extra packages for the small screen
[ -n "$FB" ] && PACKAGES="$PACKAGES xserver-xorg-core xserver-xorg-video-fbdev xserver-xorg-input-evdev xinit matchbox-window-manager fbset x11vnc"

# true if all packages are installed, lldpd is running and the command exists
has_everything() {
  for package in $PACKAGES; do
    dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -q "ok installed" || return 1
  done
  systemctl is-active --quiet lldpd && [ -e /usr/local/bin/notafluke ]
}

install_all() {
  apt-get update -q && DEBIAN_FRONTEND=noninteractive apt-get install -y -q $PACKAGES || return 1
  systemctl enable --now lldpd                      # CDP/LLDP
  # only "install" replaces an existing link, so a try copy never takes over the command
  if [ "$1" = "relink" ] || [ ! -e /usr/local/bin/notafluke ]; then
    ln -sf "$SELF" /usr/local/bin/notafluke
    ln -sf "$DIR/fluke-calibrate" /usr/local/bin/fluke-calibrate
  fi
  # start on boot and go black on shutdown, only on the Pi (a VM has no small screen)
  if [ -n "$FB" ] && [ "$1" = "relink" ]; then autostart on; blank_on_shutdown; fi
  return 0
}

# runs "notafluke blank" when the Pi shuts down. Before= makes it stop after the GUI does
blank_on_shutdown() {
  cat > /etc/systemd/system/notafluke-blank.service <<UNIT
[Unit]
Description=Black out the small screen at shutdown
Before=notafluke.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/true
ExecStop=/usr/local/bin/notafluke blank

[Install]
WantedBy=multi-user.target
UNIT
  systemctl daemon-reload && systemctl enable --now notafluke-blank.service
}

# systemd service that runs "notafluke boot" when the Pi starts. The Exit button still
# drops you to the terminal, it just won't come back until the next boot.
autostart() {
  case "$1" in
    off) systemctl disable --quiet notafluke.service 2>/dev/null
         echo "Off: it won't start on boot anymore. (Still running now if it was, notafluke stop closes it.)"; return ;;
    on) ;;
    *) if systemctl is-enabled --quiet notafluke.service 2>/dev/null; then
         echo "Autostart is ON (starts when the Pi boots). Turn off: notafluke autostart off"
       else
         echo "Autostart is OFF. Turn on: notafluke autostart on"
       fi
       return ;;
  esac
  cat > /etc/systemd/system/notafluke.service <<UNIT
[Unit]
Description=Not-A-Fluke touchscreen GUI
After=systemd-user-sessions.service lldpd.service plymouth-quit-wait.service getty@tty1.service

[Service]
Type=simple
ExecStart=/usr/local/bin/notafluke boot
Restart=no

[Install]
WantedBy=multi-user.target
UNIT
  systemctl daemon-reload && systemctl enable --quiet notafluke.service &&
    echo "On: it'll start by itself the next time the Pi boots (sudo reboot to see it now)."
}

stop() { pkill -f "Xorg $DISPLAY_NUM -config /run/notafluke" 2>/dev/null; pkill -f "$GUI_MATCH" 2>/dev/null; }

# after the GUI closes, clear the small screen and move tty1-6 back onto it
# the text console and the GUI share the one small screen. 0 = console stops drawing on it
# (otherwise the login prompt and cursor show through the GUI), 1 = console back on
console_bind() {
  for con in /sys/class/vtconsole/vtcon*/; do grep -q "frame buffer" "$con/name" && echo "$1" > "$con/bind"; done
}

closed_screen() {
  TFT_NUM=$(grep -l '^fb_' /sys/class/graphics/fb*/name 2>/dev/null | head -1 | cut -d/ -f5 | tr -d fb)
  [ -n "$TFT_NUM" ] || return
  console_bind 1
  dd if=/dev/zero of=/dev/fb$TFT_NUM bs=64k status=none 2>/dev/null
  # put tty1-6 on the small screen (matters when HDMI is fb0 and the small screen is fb1)
  for tty in 1 2 3 4 5 6; do con2fbmap $tty $TFT_NUM; done
  # switch to another console and back: forces tty1 to redraw. Without this the screen
  # stays black with just a cursor (e.g. after the GUI that started on boot is closed)
  chvt 2 2>/dev/null; sleep 0.3; chvt 1 2>/dev/null
  # X leaves the console blanked, wake it up and turn blanking off
  TERM=linux setterm --blank poke </dev/tty1 >/dev/tty1 2>/dev/null
  TERM=linux setterm --blank 0 --powerdown 0 </dev/tty1 >/dev/tty1 2>/dev/null
}

case "$1" in
  stop) stop; sleep 1; closed_screen; echo "Not-A-Fluke stopped."; exit 0 ;;
  # from the shutdown service: stop the console drawing on the small screen and paint it black,
  # so it's black instead of white once the Pi is off
  blank)
    console_bind 0
    [ -n "$FB" ] && dd if=/dev/zero of=/dev/$FB bs=64k status=none 2>/dev/null
    exit 0 ;;
  calibrate)
    # move the terminal off the screen, calibrate, then put it back
    stop; sleep 1
    for tty in 1 2 3 4 5 6; do con2fbmap $tty 0; done
    "$DIR/fluke-calibrate"
    closed_screen
    exit 0 ;;
  install) install_all relink || exit 1; echo "Installed. Start it with:  notafluke"; exit 0 ;;
  autostart) autostart "$2"; exit 0 ;;
  # share the small screen over VNC. Only on localhost, so you reach it through an SSH tunnel:
  #   ssh -t -L 5901:localhost:5901 admin@raspberrypi.local notafluke view
  # then point a VNC viewer at localhost:5901. Ctrl-C here stops sharing (the GUI keeps running)
  view)
    [ -n "$FB" ] || { echo "No small screen here, nothing to share." >&2; exit 1; }
    has_everything || install_all || exit 1
    pgrep -f "$GUI_MATCH" >/dev/null || { "$SELF"; sleep 3; }
    echo "Sharing the small screen on localhost:5901. Open your VNC viewer now. Ctrl-C to stop."
    exec x11vnc -display "$DISPLAY_NUM" -localhost -rfbport 5901 -shared -forever -nopw -quiet ;;
  boot) BOOTING=1; set -- -f ;;   # from the boot service: run in the foreground
esac

# install anything missing first
[ -n "$BOOTING" ] || has_everything || { echo "Installing what Not-A-Fluke needs (one time)..."; install_all || exit 1; }

# nowhere to show a window? say so before closing the copy that's running
if [ "$1" = "window" ] && [ -z "$DISPLAY" ]; then
  echo "notafluke: nowhere to open the window. Connect with  ssh -X admin@raspberrypi.local" >&2
  echo "  (or MobaXterm on Windows), then run  notafluke window  again." >&2
  exit 1
fi

# stop any copy already running
stop
sleep 0.5

# no small screen (VM / desktop), or "window": open a window on $DISPLAY instead.
# over "ssh -X" that window shows up on your own computer
if [ -z "$FB" ] || [ "$1" = "window" ]; then
  if [ -z "$DISPLAY" ]; then
    echo "notafluke: no small TFT screen and no desktop to open a window on." >&2
    echo "  On a VM: run it from a terminal on the VM's desktop (not plain SSH)." >&2
    echo "  On the Pi: is dtoverlay=piscreen (or tft35a) in /boot/firmware/config.txt?" >&2
    exit 1
  fi
  cd "$DIR"
  # the small screen goes back to the terminal while the GUI is on your computer
  [ "$1" = "window" ] && [ -n "$FB" ] && closed_screen
  if [ "$1" = "-f" ] || [ "$1" = "window" ]; then exec python3 -m fluke --windowed; fi
  setsid nohup python3 -m fluke --windowed >"$LOG" 2>&1 < /dev/null &
  echo "Not-A-Fluke is running in a window.  Stop: notafluke stop   Log: notafluke log"
  exit 0
fi

# small screen
# X config that only draws on the TFT, not HDMI
CONF_DIR=/run/notafluke
mkdir -p "$CONF_DIR"
cat > "$CONF_DIR/xorg.conf" <<EOF
Section "ServerFlags"
    Option "AutoAddGPU" "false"
    Option "BlankTime"   "0"
    Option "StandbyTime" "0"
    Option "SuspendTime" "0"
    Option "OffTime"     "0"
EndSection
Section "Device"
    Identifier "TFT"
    Driver     "fbdev"
    Option     "fbdev" "/dev/$FB"
EndSection
Section "Screen"
    Identifier "TFTScreen"
    Device     "TFT"
EndSection
EOF
# touchscreen with saved calibration, or raw defaults
CAL=$(grep -h '"Calibration"\|"SwapAxes"' /etc/X11/xorg.conf.d/99-calibration.conf 2>/dev/null)
[ -n "$CAL" ] || CAL='    Option "Calibration" "0 4095 0 4095"
    Option "SwapAxes" "0"'
cat >> "$CONF_DIR/xorg.conf" <<EOF
Section "InputClass"
    Identifier   "notafluke touch"
    MatchProduct "ADS7846 Touchscreen"
    MatchDevicePath "/dev/input/event*"
    Driver       "evdev"
$CAL
EndSection
EOF

# X session: no blanking, no cursor, then the GUI
cat > "$CONF_DIR/session" <<EOF
#!/bin/sh
xset s off -dpms 2>/dev/null
# Tiny window manager so the GUI's fullscreen fills the whole small screen.
matchbox-window-manager -use_titlebar no -use_cursor no &
cd "$DIR" && exec python3 -m fluke
EOF
chmod +x "$CONF_DIR/session"

# -sharevts -novtswitch so it doesn't take over the HDMI console
CMD=(xinit "$CONF_DIR/session" -- /usr/bin/Xorg "$DISPLAY_NUM" -config "$CONF_DIR/xorg.conf"
     vt8 -sharevts -novtswitch -nolisten tcp -nocursor
     -logfile /tmp/notafluke-xorg.log)

# run the GUI, then give the screen back to the terminal
run() { console_bind 0; "${CMD[@]}"; closed_screen; }

if [ "$1" = "-f" ]; then
  run; exit
fi
export -f run closed_screen console_bind
export CMD_STR="$(printf '%q ' "${CMD[@]}")"
setsid nohup bash -c 'eval "CMD=($CMD_STR)"; run' >"$LOG" 2>&1 < /dev/null &
echo "Not-A-Fluke is running on the small screen.  Stop: notafluke stop   Log: notafluke log"
